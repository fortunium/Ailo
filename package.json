{
  "name": "ailo",
  "productName": "Ailo",
  "version": "0.1.0",
  "description": "Eén rustige werkplek voor meerdere AI-codeassistenten en accounts.",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "proof": "node scripts/isolation-proof.mjs",
    "pack": "npm run build && electron-builder --dir --publish never",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never && node scripts/checksums.mjs",
    "dist:linux": "npm run build && electron-builder --linux --x64 --publish never && node scripts/checksums.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.316",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cron-parser": "^5.10.3",
    "lowlight": "^3.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "author": "Cerebellum90"
}
